<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ========================================================== -->
    <!-- reservation-common : 公共工具模块 (纯 POJO, 无 Web 依赖)    -->
    <!-- ========================================================== -->

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.urban.script</groupId>
        <artifactId>urban-script-reservation</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>reservation-common</artifactId>
    <packaging>jar</packaging>
    <name>reservation-common</name>
    <description>公共模块: R / ResultCode / BusinessException / GlobalExceptionHandler / JwtUtil</description>

    <dependencies>
        <!-- jjwt 0.12.x -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 纯 API, 无运行时实现 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- provided scope: 编译需要, 运行时由业务服务 starter-web 提供 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Servlet API: TraceIdFilter 编译需要, 运行时由各业务服务 starter-web / starter-tomcat 提供 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- @ConditionalOnWebApplication / @ConditionalOnClass: TraceIdFilter 只在 Servlet 服务注册,
             防止污染纯 WebFlux 的 reservation-gateway 网关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OpenFeign: 仅编译期需要 RequestInterceptor 接口，版本由 Spring Cloud BOM 管理 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- FieldError / BindException / Valid 注解: 版本由 Spring Boot parent 锁定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- 纯工具 jar, 跳过 spring-boot repackage -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
