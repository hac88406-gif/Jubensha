<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ========================================================== -->
    <!-- user-service : 用户微服务 (端口 8082, MVC)                   -->
    <!-- 技术栈: Spring Boot 3.2.5 | Nacos Discovery+Config          -->
    <!--         MyBatis-Plus 3.5.5 | Knife4j 4.5.0                  -->
    <!-- ========================================================== -->

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.urban.script</groupId>
        <artifactId>urban-script-reservation</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>user-service</artifactId>
    <packaging>jar</packaging>
    <name>user-service</name>
    <description>用户微服务: 注册 / 登录 / JWT / 角色鉴权 (端口 8082)</description>

    <dependencies>
        <!-- ========== 公共模块 ========== -->
        <dependency>
            <groupId>com.urban.script</groupId>
            <artifactId>reservation-common</artifactId>
        </dependency>

        <!-- ========== Spring Boot Starter ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========== 数据库 ========== -->
        <!-- MySQL 8.x 驱动: Spring Boot parent 已锁版本 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis-Plus 3.5.5 for Spring Boot 3.x (版本需显式声明, 不在 Spring Boot BOM 中) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.5</version>
        </dependency>

        <!-- ========== Spring Cloud Alibaba ========== -->
        <!-- Nacos 服务发现 (版本由 Spring Cloud Alibaba BOM 管理) -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心 (shared-configs 共享配置) -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- ========== Knife4j OpenAPI 3 (Spring Boot 3 + Jakarta) ========== -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>4.5.0</version>
        </dependency>

        <!-- ========== 密码加密 (BCryptPasswordEncoder) ========== -->
        <!-- spring-security-crypto 版本由 Spring Boot parent BOM 管理 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ========== AOP (角色拦截切面 RoleAspect 需要) ========== -->
        <!-- spring-boot-starter-web 只带 spring-aop, 不够 AspectJ 注解 API, 必须显式加 starter-aop -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ========== 其他 ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- ========== 测试 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 可执行 jar: 覆盖父 POM 的 skip=true，开启 repackage -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
