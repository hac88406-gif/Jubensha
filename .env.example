# =============================================================================
# 环境变量模板 —— 复制为 .env 后填写
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会进入仓库
# =============================================================================
#
# 【Java 侧】各服务 application.yml 中的敏感配置均支持同名环境变量覆盖，
#            优先级：Nacos urban-shared-config  >  环境变量  >  application.yml 本地默认值。
#   JWT_SECRET              JWT 签名密钥（长度 >= 32 字节）
#                           ⚠️ 所有服务必须使用同一个值，否则会出现"登录成功但接口全 401"
#   JWT_EXPIRE_MILLIS       token 有效期（毫秒），默认 7200000（2 小时）
#   PAY_SIGN_SECRET         支付回调 HMAC 验签密钥
#                           ⚠️ 回调接口免鉴权、靠验签自证身份，不替换等于允许伪造支付
#   URBAN_INTERNAL_API_KEY  服务间内部接口鉴权 Key（X-Internal-Api-Key）
#
# 【Python 侧】python-agent 读取以下变量：
#   LLM_API_KEY             LLM API Key（DeepSeek / 硅基流动）
#   INTERNAL_API_KEY        与上面的 URBAN_INTERNAL_API_KEY 保持一致，否则内部接口 403
#   JAVA_BASE_URL           agent-gateway 地址
#   REDIS_URL               Redis 连接串（会话记忆）
#
# ⚠️ 生产环境建议把上述敏感项统一放进 Nacos urban-shared-config，
#    让 Java 各服务与 Python Agent 都从同一处取值，避免多份副本不一致。
# =============================================================================

# ---------- Java 服务敏感配置 ----------
JWT_SECRET=
JWT_EXPIRE_MILLIS=7200000
PAY_SIGN_SECRET=
URBAN_INTERNAL_API_KEY=

# ---------- Python Agent ----------
LLM_API_KEY=
INTERNAL_API_KEY=
JAVA_BASE_URL=http://localhost:8085
REDIS_URL=redis://localhost:6379/1
